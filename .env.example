# ==============================================================================
# FYNUX OS — ENVIRONMENT VARIABLES TEMPLATE
# Salin file ini menjadi .env.local untuk environment development lokal.
# ==============================================================================

# Application Base
NEXT_PUBLIC_APP_NAME="Fynux OS"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Supabase (PostgreSQL Database & Auth)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Google Gemini AI (Free Tier API)
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-1.5-flash"

# Duitku Payment Gateway (QRIS / Virtual Account)
DUITKU_MERCHANT_CODE="your-merchant-code"
DUITKU_API_KEY="your-merchant-api-key"
DUITKU_ENV="sandbox" # sandbox | production
DUITKU_CALLBACK_URL="http://localhost:3000/api/webhooks/duitku"
DUITKU_RETURN_URL="http://localhost:3000/finance"

# Internal Bank Account (Manual Transfer BCA)
NEXT_PUBLIC_BCA_ACCOUNT_NUMBER="1234567890"
NEXT_PUBLIC_BCA_ACCOUNT_HOLDER="Fynux Digital Solutions"

# System Cron & Automation Secret (Untuk verifikasi pemanggilan endpoint cron)
CRON_SECRET="your-cron-secret-token"
