# Shared Drive HQ Storage (Ubuntu VPS Root / Local)
# Lokasi folder penyimpanan file fisik di server VPS (contoh: /var/www/fynux-drive/storage atau ./data/drive/storage)
DRIVE_STORAGE_PATH="./data/drive/storage"
# Kapasitas alokasi penyimpanan yang ditampilkan pada quota meter di UI (dalam satuan GB)
DRIVE_TOTAL_STORAGE_GB="100"
